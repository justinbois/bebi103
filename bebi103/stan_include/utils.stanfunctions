        /**
     * Compute log(-sum(exp(neg_terms)) + sum(exp(pos_terms))).
     *
     * @param neg_term Array of reals
     * @param pos_terms Array of reals
     * @return log(-exp(neg_term) + sum(exp(pos_terms)))
     */
    real log_sum_exp_neg(array[] real neg_terms, array[] real pos_terms) {
        real log_sum_exp_pos = log_sum_exp(pos_terms);
        real log_sum_exp_neg = log_sum_exp(neg_terms);

        if (log_sum_exp_pos < log_sum_exp_neg) {
            reject("Error encountered in logsumexp calculation with negative terms.");
        }

        return log_sum_exp_pos + log1m_exp(log_sum_exp_neg - log_sum_exp_pos);
    }


